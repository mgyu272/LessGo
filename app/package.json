{
  "name": "seongbuk-runtrip",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "성북 런트립 — 외국인 러너를 성북구 명소와 동네 가게로 잇는 러닝 관광 웹앱 (React + Vite + Supabase)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "eval:ask": "node --env-file-if-exists=.env.local scripts/eval-ask.mjs",
    "shops:add": "node --env-file-if-exists=.env.local scripts/add-shops.mjs",
    "shops:explore": "node --env-file-if-exists=.env.local scripts/add-explore-shops.mjs",
    "eval:heritage:validate": "node scripts/validate-heritage-vision-eval.mjs",
    "eval:heritage:self-test": "node scripts/test-heritage-vision-evaluation.mjs",
    "eval:heritage:live": "node --env-file-if-exists=.env.local scripts/run-heritage-vision-eval.mjs --live"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/roboto": "^5.3.0",
    "firebase": "^11.10.0",
    "h3-js": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-kakao-maps-sdk": "^1.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
