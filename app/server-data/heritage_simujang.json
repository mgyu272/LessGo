  "facts": [
    {
      "id": "S01",
      "objectId": "site",
      "ko": "심우장은 서울특별시 성북구 성북로29길 24에 있다.",
      "sourceIds": [
        "SB",
        "ARCH"
      ],
      "certainty": "documented"
    },
    {
      "id": "S02",
      "objectId": "site",
      "ko": "만해 한용운이 1933년부터 1944년 6월 29일 입적할 때까지 심우장에서 살았다.",
      "sourceIds": [
        "ARCH",
        "SB"
      ],
      "certainty": "documented"
    },
    {
      "id": "S03",
      "objectId": "site",
      "ko": "심우장은 2019년 4월 8일 국가 사적으로 지정되었다.",
      "sourceIds": [
        "SB",
        "ARCH"
      ],
      "certainty": "documented"
    },
    {
      "id": "S04",
      "objectId": "site",
      "ko": "한용운은 3·1운동 민족대표 33인 중 한 명이며 시집 『님의 침묵』의 시인이다.",
      "sourceIds": [
        "SB",
        "ARCH"
      ],
      "certainty": "documented"
    },
    {
      "id": "S05",
      "objectId": "site",
      "ko": "한용운은 심우장에 머물며 불교 개혁운동과 독립운동을 이어갔다.",
      "sourceIds": [
        "ARCH"
      ],
      "certainty": "documented"
    },
    {
      "id": "S06",
      "objectId": "site",
      "ko": "한용운은 심우장에서 소설 『흑풍』을 집필했다.",
      "sourceIds": [
        "ARCH"
      ],
      "certainty": "documented"
    },
    {
      "id": "S07",
      "objectId": "site",
      "ko": "심우장의 집터는 벽산 스님이 제공했고 수학교사 최수동이 설계했으며 여러 후원자가 건립을 도왔다.",
      "sourceIds": [
        "ARCH"
      ],
      "certainty": "documented"
    },
    {
      "id": "S08",
      "objectId": "site",
      "ko": "심우(尋牛)라는 이름은 소를 찾는 일에 비유한 불교의 깨달음·수행 이야기에서 유래한다.",
      "sourceIds": [
        "SB",
        "ARCH"
      ],
      "certainty": "documented"
    },
    {
      "id": "B01",
      "objectId": "main_house",
      "ko": "심우장 본채는 북쪽을 향하는 기와집이다.",
      "sourceIds": [
        "SB",
        "MUCH"
      ],
      "certainty": "documented"
    },
    {
      "id": "B02",
      "objectId": "main_house",
      "ko": "남쪽의 조선총독부를 바라보지 않기 위해 북향으로 집을 지었다는 이야기가 전한다.",
      "sourceIds": [
        "MUCH",
        "ARCH"
      ],
      "certainty": "reported_tradition"
    },
    {
      "id": "B03",
      "objectId": "main_house",
      "ko": "성북구청 설명에 따르면 심우장은 전체 5칸 규모의 작은 집이다.",
      "sourceIds": [
        "SB"
      ],
      "certainty": "documented"
    },
    {
      "id": "B04",
      "objectId": "main_house",
      "ko": "성북구청은 가운데 대청, 왼쪽 온돌방, 오른쪽 부엌, 부엌 뒤 찬마루방으로 공간을 소개한다.",
      "sourceIds": [
        "SB"
      ],
      "certainty": "documented"
    },
    {
      "id": "B05",
      "objectId": "main_house",
      "ko": "심우장은 당시 주변 주거지의 일반적인 주택과 달리 검소하고 소박한 외관을 보여준다.",
      "sourceIds": [
        "SB"
      ],
      "certainty": "documented"
    },
    {
      "id": "P01",
      "objectId": "signboard",
      "ko": "심우장 현판의 글씨는 독립운동가이자 서예가인 오세창이 썼다.",
      "sourceIds": [
        "MUCH"
      ],
      "certainty": "documented"
    },
    {
      "id": "P02",
      "objectId": "signboard",
      "ko": "성북구청은 한용운의 서재였던 온돌방에 심우장 현판이 걸려 있다고 소개한다.",
      "sourceIds": [
