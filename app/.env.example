# 이 파일을 복사해서 이름을 .env.local 로 바꾸고 값을 채우세요. (.env.local 은 GitHub에 안 올라가요)

# ── Firebase (로그인·DB·랭킹) ── Firebase 콘솔 → 프로젝트 설정 → 일반 → 내 앱 → SDK 설정 및 구성 → 구성
# 비워 두면 "로컬 모드"(이 휴대폰에만 저장)로 동작해요. 보안 규칙(firestore.rules) 적용은 README 4번
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── 카카오 지도 ── Kakao Developers → 내 애플리케이션 → 앱 키 → JavaScript 키
# 브라우저로 가는 공개 키예요. 대신 카카오 디벨로퍼스에서 사이트 도메인(localhost, 배포 주소)을 꼭 등록하세요.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ── Gemini (질문 답변·AI 코스 추천) ── Google AI Studio → Get API key
# 키는 서버 함수(api/)에서만 써요. VITE_ 로 시작하지 않아서 브라우저로 안 나가요.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 선택 사항: 이미지 분석에만 별도 모델 사용. 비우면 GEMINI_MODEL을 사용해요.
GEMINI_IMAGE_MODEL=
# 참고 사진 후보 선택은 opt-in. 기본 분석은 유지되며 이 값만으로 외부 전송되지는 않아요.
GEMINI_IMAGE_REFERENCE_MODE=0
# 출처와 외부 Gemini 사용 권한이 확인된 뒤에만 1로 설정하세요. manifest의 승인 상태도 true여야 해요.
GEMINI_IMAGE_REFERENCE_EXTERNAL_OK=0

# 키가 아직 없을 때 1 로 두면 "가짜 AI"로 AI 화면 흐름을 확인할 수 있어요. 키를 넣으면 자동으로 무시돼요.
GEMINI_MOCK=1
# 이미지 분석의 테스트 데이터 응답은 별도 opt-in이에요. 기본값 0은 가짜 결과를 반환하지 않아요.
GEMINI_IMAGE_MOCK=0
