# 이 파일을 복사해서 이름을 .env.local 로 바꾸고 값을 채우세요. (.env.local 은 GitHub에 안 올라가요)

# ── Supabase (로그인·DB·랭킹) ── Supabase → Project Settings → API (또는 Connect) 에서 복사
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=여기에_anon_또는_publishable_키

# ── Gemini (질문 답변·AI 코스 추천) ── Google AI Studio → Get API key
# 키는 서버 함수(api/)에서만 써요. VITE_ 로 시작하지 않아서 브라우저로 안 나가요.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 키가 아직 없을 때 1 로 두면 "가짜 AI"로 AI 화면 흐름을 확인할 수 있어요. 키를 넣으면 자동으로 무시돼요.
GEMINI_MOCK=1
